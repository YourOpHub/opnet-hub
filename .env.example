# Copy to .env and fill. Never commit .env.
# Used by: npm run deploy (or node scripts/deploy.js)

# Backend API URL (used by game sync, Bob MCP proxy)
# Leave empty to disable backend API calls (gh-pages mode)
VITE_API_URL=https://your-server.com

# VPS
VPS_HOST=your-server.com
VPS_USER=deploy
VPS_PATH=/var/www/opnet-hub

# Optional: SSH key path (default: ~/.ssh/id_rsa)
# SSH_KEY_PATH=~/.ssh/id_ed25519

# Optional: Cloudflare API Token (Zone DNS Edit) — to verify proxy or update DNS
# Get: Dashboard → My Profile → API Tokens → Create (Zone:Read + DNS:Edit)
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ZONE_ID=...
