# OPNet Hub Server Configuration
PORT=4000
NODE_ENV=production

# Bob MCP proxy target
BOB_MCP_URL=https://ai.opnet.org/mcp

# $MINE token contract (set after deployment)
MINE_CONTRACT_ADDRESS=

# OP_NET RPC
OPNET_RPC_URL=https://testnet.opnet.org/api/v1/json-rpc

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS allowed origins
CORS_ORIGINS=https://yourophub.github.io,http://localhost:3000
